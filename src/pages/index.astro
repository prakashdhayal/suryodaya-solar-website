---
import { Picture } from 'astro:assets';
import BrandGrid from '../components/BrandGrid.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import InstallationCard from '../components/InstallationCard.astro';
import Lightbox from '../components/Lightbox.astro';
import NewsCards from '../components/NewsCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ActionButtons from '../components/ActionButtons.astro';
import Base from '../layouts/Base.astro';
import { INVERTER_BRANDS, PANEL_BRANDS } from '../data/brands';
import { link } from '../data/site';
import { installations, kw, totals } from '../lib/installations';
import { currentNotices } from '../lib/notices';
import commercialRoof from '../assets/site/commercial-rooftop-solar.jpg';
import hero from '../assets/site/hero-solar-panels-blue-sky.jpg';
import rooftop from '../assets/site/rooftop-panel-installation.jpg';
import technician from '../assets/site/technician-wiring-solar-panel.jpg';

const all = await installations();
const recent = all.filter((i) => i.photo).slice(0, 3);
const sum = totals(all);
const news = (await currentNotices()).slice(0, 3);
---

<Base
  fullTitle="Solar Company in Ajmer | Suryodaya Solar Power"
  title="Home"
  description="Suryodaya Solar Power installs on-grid, off-grid and hybrid solar systems for homes and businesses in Ajmer. DCR and non-DCR panels, top inverter brands."
  quoteHref="#enquiry"
>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      src={hero}
      alt=""
      class="hero-media"
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      quality={55}
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-inner">
      <span class="eyebrow">Suryodaya Solar Power · Ajmer</span>
      <h1 id="hero-title">Solar Panel Installation in <span class="accent">Ajmer</span></h1>
      <p class="lead">A solar installation company in Ajmer: on-grid, off-grid and hybrid systems for homes and businesses, with DCR and non-DCR panels and single- and three-phase inverters from leading brands.</p>
      <ActionButtons onDark quoteHref="#enquiry" />
      <ul class="hero-facts">
        <li><Icon name="check" size={20} />On-grid · Off-grid · Hybrid</li>
        <li><Icon name="check" size={20} />Homes and businesses</li>
        <li><Icon name="check" size={20} />5 panel brands · 7 inverter brands</li>
      </ul>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section tight news-band" aria-labelledby="news-title">
        <div class="wrap">
          <div class="row-head">
            <h2 id="news-title">Latest news</h2>
            <a class="text-link" href={link('/news/')}>All news & guides <Icon name="arrow" size={18} /></a>
          </div>
          <NewsCards notices={news} />
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">About us</span>
        <h2 id="intro-title">Solar power for Ajmer’s homes and businesses</h2>
        <p class="lead">
          Suryodaya Solar Power installs solar systems in Ajmer - on-grid, off-grid and hybrid - for houses, shops, offices
          and factories.
        </p>
        <ul class="check-list">
          <li>Domestic and commercial solar plant installation</li>
          <li>DCR and non-DCR solar panels from Tata Power Solar, Waaree, Adani Solar, Luminous and Vikram Solar</li>
          <li>Single-phase and three-phase inverters from seven brands</li>
        </ul>
        <a class="text-link" href={link('/about/')}>More about us <Icon name="arrow" size={18} /></a>
      </div>
      <div class="split-media reveal">
        <Picture src={technician} alt="A technician connecting the wiring of a solar panel" formats={['avif', 'webp']} widths={[480, 800, 1100]} sizes="(min-width: 900px) 46vw, 92vw" quality={70} />
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead
        id="services-title"
        eyebrow="Our solar services"
        heading="Solar systems for every need"
        lead="Choose by how you use power - with the grid, without it, or both - and by where it goes: your home or your business."
        center
      />
      <ServiceCards />
    </div>
  </section>

  <section class="section" aria-labelledby="audience-title">
    <div class="wrap">
      <SectionHead id="audience-title" eyebrow="Residential & commercial" heading="For your home or your business" center />
      <div class="audience">
        <article class="audience-card reveal">
          <Picture src={rooftop} alt="A solar panel being fitted on a house roof" formats={['avif', 'webp']} widths={[480, 800, 1100]} sizes="(min-width: 800px) 46vw, 92vw" quality={70} />
          <div class="audience-body">
            <h3><a href={link('/solar-solutions/residential-solar/')}>Domestic solar plants</a></h3>
            <ul class="check-list">
              <li>Rooftop systems for houses, villas and farmhouses</li>
              <li>Single-phase or three-phase, to match your connection</li>
              <li>Hybrid systems for backup during power cuts</li>
            </ul>
            <a class="btn btn-ghost" href={link('/solar-solutions/residential-solar/')}>Solar for homes <Icon name="arrow" size={18} /></a>
          </div>
        </article>
        <article class="audience-card reveal">
          <Picture src={commercialRoof} alt="Solar panels across a large commercial roof at sunrise" formats={['avif', 'webp']} widths={[480, 800, 1100]} sizes="(min-width: 800px) 46vw, 92vw" quality={70} />
          <div class="audience-body">
            <h3><a href={link('/solar-solutions/commercial-solar/')}>Commercial solar plants</a></h3>
            <ul class="check-list">
              <li>Shops, offices, schools, hospitals, hotels and factories</li>
              <li>Three-phase systems on roofs, sheds or open ground</li>
              <li>Planned around your working hours</li>
            </ul>
            <a class="btn btn-ghost" href={link('/solar-solutions/commercial-solar/')}>Solar for businesses <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section soft" aria-labelledby="steps-title">
    <div class="wrap">
      <SectionHead id="steps-title" eyebrow="How it works" heading="From enquiry to installation" center />
      <ProcessSteps />
    </div>
  </section>

  <section class="section" aria-labelledby="brands-title">
    <div class="wrap">
      <SectionHead
        id="brands-title"
        eyebrow="Products & brands"
        heading="Panels and inverters we supply"
        lead="DCR and non-DCR solar panels, and single-phase and three-phase inverters."
        center
      />
      <div class="brand-block">
        <BrandGrid brands={PANEL_BRANDS} title="Solar panel brands" icon="panel" kinds={['DCR', 'non-DCR']} />
        <BrandGrid brands={INVERTER_BRANDS} title="Inverter brands" icon="inverter" kinds={['single-phase', 'three-phase']} />
      </div>
      <div class="section-foot"><a class="btn btn-ghost" href={link('/products/')}>See products & brands <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead
        id="work-title"
        eyebrow="Projects"
        heading="Our installations"
        lead={`${sum.count} systems, ${kw(sum.kw)} in all, in Ajmer and the villages and towns around it.`}
        center
      />
      <div class="inst-grid">
        {recent.map((i) => <InstallationCard item={i} />)}
      </div>
      <div class="section-foot"><a class="btn btn-primary" href={link('/projects/')}>See all {sum.count} installations <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <Lightbox />

  <CtaBand quoteHref="#enquiry" />

  <ContactSection />
</Base>
