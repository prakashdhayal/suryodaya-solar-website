---
import ActionButtons from '../components/ActionButtons.astro';
import Base from '../layouts/Base.astro';
import { link } from '../data/site';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="section">
    <div class="wrap prose">
      <span class="eyebrow">404</span>
      <h1>This page could not be found</h1>
      <p class="lead">The link may be old or mistyped. Go to the <a href={link('/')}>home page</a>, see our <a href={link('/solar-solutions/')}>solar solutions</a>, or reach us directly:</p>
      <ActionButtons />
    </div>
  </section>
</Base>
