---
/** One customer's installation: what was installed, where and when, their words, and every photo and video of it. */
import CtaBand from '../../components/CtaBand.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Icon from '../../components/Icon.astro';
import InstallationCard from '../../components/InstallationCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import Base from '../../layouts/Base.astro';
import { link } from '../../data/site';
import { SOLUTIONS } from '../../data/solutions';
import { installations, kw, placePages, placeSlug, type Installation } from '../../lib/installations';

export async function getStaticPaths() {
  return (await installations()).map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item: i } = Astro.props as { item: Installation };
const solution = SOLUTIONS.find((s) => s.preset.system === i.type)!;
const placePage = (await placePages()).find((p) => p.slug === placeSlug(i.place));
const others = (await installations()).filter((o) => o.slug !== i.slug).slice(0, 3);
const where = i.district && i.district !== i.place ? `${i.place}, ${i.district}` : i.place;
const facts: [string, string, string?][] = [
  ['Capacity', kw(i.capacityKw)],
  ['System', i.type, link(`/solar-solutions/${solution.slug}/`)],
  ['Solar panels', i.panels + (i.panelKind ? ` (${i.panelKind})` : '')],
  ...(i.inverter ? [['Inverter', i.inverter] as [string, string]] : []),
  ['Village / City', where, placePage && link(`/solar-installation/${placePage.slug}/`)],
  ['Installed', i.month],
];
---

<Base
  title={`${i.customer}, ${i.place}`}
  fullTitle={`${kw(i.capacityKw)} ${i.type} Solar in ${i.place} - ${i.customer} | Suryodaya Solar`}
  description={`A ${kw(i.capacityKw)} ${i.type.toLowerCase()} solar system with ${i.panels} panels, installed by Suryodaya Solar Power for ${i.customer} in ${where} in ${i.month}. Photos of the installation.`}
  crumbs={[
    { name: 'Installations', href: '/projects/' },
    { name: i.customer, href: `/projects/${i.slug}/` },
  ]}
  noindex={i.sample}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Installation · {i.month}</span>
      <h1>{i.customer}<span class="h1-sub">{where}</span></h1>
      {i.sample && <p class="notice"><Icon name="sun" size={20} />This is a sample, to show how a customer's page will look. Its photos are sample images.</p>}
      <dl class="facts">
        {
          facts.map(([name, value, href]) => (
            <div>
              <dt>{name}</dt>
              <dd>{href ? <a href={href}>{value}</a> : value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    i.feedback && (
      <section class="section tight" aria-label="What the customer said">
        <div class="wrap">
          <figure class="said reveal">
            <Icon name="chat" size={28} />
            <blockquote>
              <p>{i.feedback}</p>
            </blockquote>
            <figcaption>
              {i.customer}, {i.place}
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class:list={['section', { tight: i.feedback, alt: i.feedback }]} aria-labelledby="photos-title">
    <div class="wrap">
      <h2 id="photos-title">Photos{i.videoCount ? ' and videos' : ''}</h2>
      {i.media.length ? <GalleryGrid items={i.media} /> : <p class="lead">Photos of this installation will be added soon.</p>}
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section tight" aria-labelledby="more-title">
        <div class="wrap">
          <h2 id="more-title">More installations</h2>
          <div class="inst-grid">
            {others.map((o) => <InstallationCard item={o} />)}
          </div>
          <div class="section-foot">
            <a class="btn btn-ghost" href={link('/projects/')}>All installations <Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </section>
    )
  }

  <CtaBand heading={`Want ${i.type === 'Hybrid' ? 'a' : 'an'} ${i.type.toLowerCase()} system like this?`} />
  <Lightbox />
</Base>
