---
/**
 * Every installation in one table - customer, village or city, panels, capacity, type and a link to its photos - with
 * filters. Below 760px each row is a card (the table's own cells, laid out by CSS: one markup for both).
 */
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { installations, kw, placePages, placeSlug, totals } from '../../lib/installations';
import { link } from '../../data/site';

const items = await installations();
const samples = items.some((i) => i.sample);
const sum = totals(items);
const types = (['On-Grid', 'Off-Grid', 'Hybrid'] as const).filter((t) => items.some((i) => i.type === t));
const places = [...new Map(items.map((i) => [placeSlug(i.place), i.place])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const placeHref = new Map((await placePages()).map((p) => [p.slug, link(`/solar-installation/${p.slug}/`)]));
const mediaLabel = (photos: number, videos: number) =>
  [photos && `${photos} photo${photos > 1 ? 's' : ''}`, videos && `${videos} video${videos > 1 ? 's' : ''}`].filter(Boolean).join(', ') || 'Details';
---

<Base
  title="Our Installations"
  fullTitle="Our Solar Installations in Ajmer | Suryodaya Solar Power"
  description="Solar systems installed by Suryodaya Solar Power in and around Ajmer: customer, village or city, panel brand, capacity and type, with photos of each."
  pageType="CollectionPage"
  crumbs={[{ name: 'Installations', href: '/projects/' }]}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Projects</span>
      <h1>Our Solar Installations</h1>
      <p class="lead">Every system we have installed - who, where, which panels and how big - with photos of each one.</p>
      {
        !samples && (
          <ul class="stats" role="list">
            <li><strong>{sum.count}</strong><span>installation{sum.count > 1 ? 's' : ''}</span></li>
            <li><strong>{kw(sum.kw)}</strong><span>installed</span></li>
            <li><strong>{sum.places}</strong><span>village{sum.places > 1 ? 's and cities' : ' or city'}</span></li>
          </ul>
        )
      }
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      {
        samples && (
          <div class="notice">
            <Icon name="sun" size={20} />
            <p>These rows are samples, to show how the list will look. Our customers' installations will appear here as they are added.</p>
          </div>
        )
      }

      <div class="list-tools">
        {
          types.length > 1 && (
            <div class="filters" role="group" aria-label="System type">
              <button type="button" data-type="" aria-pressed="true">All</button>
              {types.map((t) => <button type="button" data-type={t} aria-pressed="false">{t}</button>)}
            </div>
          )
        }
        <div class="list-search">
          {
            places.length > 1 && (
              <label>
                <span class="sr-only">Village or city</span>
                <select data-place>
                  <option value="">All villages and cities</option>
                  {places.map(([slug, name]) => <option value={slug}>{name}</option>)}
                </select>
              </label>
            )
          }
          <label>
            <span class="sr-only">Search</span>
            <input type="search" data-search placeholder="Search a name, place or brand" autocomplete="off" />
          </label>
        </div>
      </div>
      <p class="list-count" aria-live="polite" data-count>{items.length} installation{items.length > 1 ? 's' : ''}</p>

      <div class="inst-table-wrap">
        <table class="inst-table">
          <caption class="sr-only">Our solar installations</caption>
          <thead>
            <tr>
              <th scope="col">Customer</th>
              <th scope="col">Village / City</th>
              <th scope="col">Solar panels</th>
              <th scope="col">Capacity</th>
              <th scope="col">Type</th>
              <th scope="col"><span class="sr-only">Photos</span></th>
            </tr>
          </thead>
          <tbody>
            {
              items.map((i) => (
                <tr
                  data-type={i.type}
                  data-place={placeSlug(i.place)}
                  data-text={[i.customer, i.place, i.district, i.panels, i.inverter].filter(Boolean).join(' ').toLowerCase()}>
                  <th scope="row">
                    <a href={i.href}>{i.customer}</a>
                    {i.sample && <span class="tag sun">Sample</span>}
                    <span class="row-month">{i.month}</span>
                  </th>
                  <td data-label="Village / City">
                    {placeHref.has(placeSlug(i.place)) ? <a href={placeHref.get(placeSlug(i.place))}>{i.place}</a> : i.place}
                  </td>
                  <td data-label="Solar panels">
                    {i.panels}
                    {i.panelKind && <span class="row-kind">{i.panelKind}</span>}
                  </td>
                  <td data-label="Capacity" class="num">{kw(i.capacityKw)}</td>
                  <td data-label="Type">
                    <span class:list={['type-tag', `t-${i.type.toLowerCase()}`]}>{i.type}</span>
                  </td>
                  <td class="row-go">
                    <a class="btn btn-ghost btn-sm" href={i.href}>
                      <Icon name="panel" size={18} />
                      {mediaLabel(i.photoCount, i.videoCount)}
                      <span class="sr-only"> of {i.customer}'s installation</span>
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="list-empty" data-empty hidden>No installation matches. <button type="button" class="link-btn" data-clear>Show all</button></p>
      </div>
    </div>
  </section>

  <CtaBand heading="Want a system like these?" />
</Base>

<script>
  // the type buttons, the place and the search narrow the rows down together
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.inst-table tbody tr')];
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('button[data-type]');
  const place = document.querySelector<HTMLSelectElement>('select[data-place]');
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let type = '';

  function apply() {
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const show =
        (!type || row.dataset.type === type) &&
        (!place?.value || row.dataset.place === place.value) &&
        words.every((w) => row.dataset.text!.includes(w));
      row.hidden = !show;
      if (show) shown++;
    }
    const noun = (n: number) => `installation${n === 1 ? '' : 's'}`;
    count.textContent = shown === rows.length ? `${rows.length} ${noun(rows.length)}` : `${shown} of ${rows.length} ${noun(rows.length)}`;
    empty.hidden = shown > 0;
  }

  typeButtons.forEach((button) =>
    button.addEventListener('click', () => {
      type = button.dataset.type!;
      typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      apply();
    }),
  );
  place?.addEventListener('change', apply);
  search.addEventListener('input', apply);
  document.querySelector('[data-clear]')!.addEventListener('click', () => {
    type = '';
    typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(!b.dataset.type)));
    if (place) place.value = '';
    search.value = '';
    apply();
  });
</script>
