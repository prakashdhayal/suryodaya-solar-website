---
/** Every customer we have installed for, as a table (CustomerTable.astro) with the totals above it. */
import CtaBand from '../../components/CtaBand.astro';
import CustomerTable from '../../components/CustomerTable.astro';
import Lightbox from '../../components/Lightbox.astro';
import Base from '../../layouts/Base.astro';
import { installations, kw, totals } from '../../lib/installations';

const items = await installations();
const sum = totals(items);
---

<Base
  title="Our Installations"
  fullTitle="Our Solar Installations in Ajmer | Suryodaya Solar Power"
  description={`${sum.count} solar systems installed by Suryodaya Solar Power in Ajmer, Kishangarh, Parbatsar and nearby villages: customer, village or city, capacity and panel brand, with a photo of each.`}
  pageType="CollectionPage"
  crumbs={[{ name: 'Installations', href: '/projects/' }]}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Projects</span>
      <h1>Our Solar Installations</h1>
      <p class="lead">Every system we have installed - who, where, how big and which panels - with a photo of each one.</p>
      <ul class="stats" role="list">
        <li><strong>{sum.count}</strong><span>installations</span></li>
        <li><strong>{kw(sum.kw)}</strong><span>installed</span></li>
        <li><strong>{sum.places}</strong><span>villages and cities</span></li>
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <CustomerTable items={items} caption="Our solar installations" />
    </div>
  </section>

  <Lightbox />
  <CtaBand heading="Want a system like these?" />
</Base>
