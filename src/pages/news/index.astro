---
/** News: the current notices, the guides, and the notices that have ended. */
import { getCollection } from 'astro:content';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import NewsCards from '../../components/NewsCards.astro';
import Base from '../../layouts/Base.astro';
import { link } from '../../data/site';
import { notices } from '../../lib/notices';

const all = await notices();
const current = all.filter((n) => !n.ended);
const earlier = all.filter((n) => n.ended);
const guides = (await getCollection('guides')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base
  title="News & Guides"
  fullTitle="Solar News & Guides for Ajmer | Suryodaya Solar Power"
  description="News from Suryodaya Solar Power and plain guides for Ajmer: the PM Surya Ghar subsidy for homes, net metering with AVVNL, and more."
  pageType="CollectionPage"
  crumbs={[{ name: 'News & Guides', href: '/news/' }]}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">News & guides</span>
      <h1>Solar News and Guides</h1>
      <p class="lead">Our announcements, and plain guides to the schemes and steps that matter for solar in Ajmer.</p>
    </div>
  </section>

  <section class="section tight" aria-labelledby="news-title">
    <div class="wrap">
      <h2 id="news-title">Latest news</h2>
      {current.length ? <NewsCards notices={current} /> : <p class="lead">Nothing new just now - our next announcement will appear here.</p>}
    </div>
  </section>

  {
    guides.length > 0 && (
      <section class="section alt tight" aria-labelledby="guides-title">
        <div class="wrap">
          <h2 id="guides-title">Guides</h2>
          <ul class="guide-list" role="list">
            {guides.map((g) => (
              <li class="guide-item reveal">
                <span class="chip-icon"><Icon name="quote" size={24} /></span>
                <div>
                  <h3><a class="stretch" href={link(`/guides/${g.id}/`)}>{g.data.h1}</a></h3>
                  <p>{g.data.lead}</p>
                </div>
                <Icon name="arrow" size={20} class="guide-arrow" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="section tight" aria-labelledby="earlier-title">
        <div class="wrap">
          <h2 id="earlier-title">Earlier</h2>
          <NewsCards notices={earlier} />
        </div>
      </section>
    )
  }

  <CtaBand />
</Base>
