---
/**
 * A village or city's own page - only once it has PLACE_PAGE_MIN installations (src/lib/installations.ts), so every
 * such page shows real work there, never a page with nothing on it.
 */
import ContactSection from '../../components/ContactSection.astro';
import CustomerTable from '../../components/CustomerTable.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import Base from '../../layouts/Base.astro';
import { link } from '../../data/site';
import { kw, placePages, totals, type Installation } from '../../lib/installations';

export async function getStaticPaths() {
  return (await placePages()).map((p) => ({ params: { place: p.slug }, props: p }));
}

const { slug, place, items } = Astro.props as { slug: string; place: string; items: Installation[] };
const sum = totals(items);
---

<Base
  title={`Solar Installation in ${place}`}
  fullTitle={`Solar Installation in ${place} | Suryodaya Solar Power`}
  description={`${sum.count} solar systems installed by Suryodaya Solar Power in ${place}, ${kw(sum.kw)} in all, with a photo of each. Enquire for your home or business.`}
  crumbs={[
    { name: 'Installations', href: '/projects/' },
    { name: place, href: `/solar-installation/${slug}/` },
  ]}
  quoteHref="#enquiry"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Installations in {place}</span>
      <h1>Solar Installation in {place}</h1>
      <p class="lead">Suryodaya Solar Power, from Ajmer, has installed these solar systems in {place}.</p>
      <ul class="stats" role="list">
        <li><strong>{sum.count}</strong><span>installations</span></li>
        <li><strong>{kw(sum.kw)}</strong><span>installed</span></li>
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <CustomerTable items={items} caption={`Our solar installations in ${place}`} />
      <div class="section-foot">
        <a class="btn btn-ghost" href={link('/projects/')}>All installations <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <Lightbox />
  <ContactSection heading={`Solar for your place in ${place}`} />
</Base>
