---
/** A card per solution, each opening its page. */
import Icon from './Icon.astro';
import { link } from '../data/site';
import { SOLUTIONS } from '../data/solutions';
---

<ul class="service-grid" role="list">
  {
    SOLUTIONS.map((s) => (
      <li class="service-card reveal">
        <span class="chip-icon"><Icon name={s.icon} size={26} /></span>
        <h3><a href={link(`/solar-solutions/${s.slug}/`)} class="stretch">{s.name}</a></h3>
        <p>{s.summary}</p>
        <span class="more" aria-hidden="true">Learn more <Icon name="arrow" size={18} /></span>
      </li>
    ))
  }
</ul>
