---
/** The mark until the client sends their logo: a sun rising over the horizon (Suryodaya). public/favicon.svg is the same. */
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <rect width="48" height="48" rx="12" fill="#15803d"></rect>
  <g stroke="#fbbf24" stroke-width="2.6" stroke-linecap="round">
    <path d="M13.6 21 10.1 19M18 16.6l-2-3.5M24 15v-4M30 16.6l2-3.5M34.4 21l3.5-2"></path>
  </g>
  <path d="M15 28a9 9 0 0 1 18 0z" fill="#fbbf24"></path>
  <path d="M8 28.5h32" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
  <path d="M13 34.5h22M17.5 40h13" stroke="#fff" stroke-opacity=".75" stroke-width="2.4" stroke-linecap="round"></path>
</svg>
