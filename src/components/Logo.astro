---
/**
 * The client's SSP logo. It was drawn on black, so its silver letters vanish on white: on a light background it sits on
 * a dark tile (`tile`), on a dark one it stands as it is. The cut-out (src/assets/brand/ssp-logo.png) was made from
 * ssp-logo-original.jpg - brightness became opacity, so the glow stays soft on any dark colour.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/ssp-logo.png';

interface Props {
  /** Height in CSS pixels; the width follows the logo's shape. */
  height?: number;
  tile?: boolean;
}
const { height = 40, tile = false } = Astro.props;
const width = Math.round((height * logo.width) / logo.height);
---

<span class:list={['logo', { 'logo-tile': tile }]}>
  <Image src={logo} alt="" width={width} height={height} densities={[1, 2]} format="webp" quality={85} loading="eager" />
</span>
