---
/** The enquiry form beside the office's details and map - the end of the home page, a solution page and Contact. */
import EnquiryForm from './EnquiryForm.astro';
import Icon from './Icon.astro';
import MapEmbed from './MapEmbed.astro';
import Tbd from './Tbd.astro';
import { ADDRESS, COMPANY, CONTACT, whatsappLink } from '../data/site';
import type { Requirement, SystemType } from '../data/solutions';

interface Props {
  heading?: string;
  lead?: string;
  system?: SystemType;
  requirement?: Requirement;
  /** h1 on the Contact page, h2 elsewhere. */
  level?: 1 | 2;
}
const {
  heading = 'Get a free quote',
  lead = 'Share a few details and we will get back to you. Prefer to talk? Call or WhatsApp us.',
  system,
  requirement,
  level = 2,
} = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="section contact-section" id="enquiry" aria-labelledby="enquiry-title">
  <div class="wrap contact-grid">
    <div class="card form-card reveal">
      <span class="eyebrow">Enquiry</span>
      <Heading id="enquiry-title">{heading}</Heading>
      <p class="lead">{lead}</p>
      <EnquiryForm system={system} requirement={requirement} />
    </div>
    <div class="contact-side reveal">
      <ul class="contact-list" role="list">
        <li>
          <span class="chip-icon"><Icon name="pin" /></span>
          <div>
            <strong>Office</strong>
            <address>
              {COMPANY.name}<br />
              {ADDRESS.lines.map((l, i) => <>{l}{i < ADDRESS.lines.length - 1 && <br />}</>)}
            </address>
          </div>
        </li>
        <li>
          <span class="chip-icon"><Icon name="phone" /></span>
          <div>
            <strong>Call</strong>
            <a href={CONTACT.phoneHref} data-track="call_click">{CONTACT.phone}</a>
          </div>
        </li>
        <li>
          <span class="chip-icon wa"><Icon name="whatsapp" /></span>
          <div>
            <strong>WhatsApp</strong>
            <a href={whatsappLink()} target="_blank" rel="noopener" data-track="whatsapp_click">{CONTACT.whatsappNumber}</a>
          </div>
        </li>
        <li>
          <span class="chip-icon"><Icon name="mail" /></span>
          <div>
            <strong>Email</strong>
            {CONTACT.email ? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> : <Tbd what="Email" />}
          </div>
        </li>
        <li>
          <span class="chip-icon"><Icon name="clock" /></span>
          <div>
            <strong>Office hours</strong>
            <span>{CONTACT.hours ?? <Tbd what="Office hours" />}</span>
          </div>
        </li>
      </ul>
      <MapEmbed />
    </div>
  </div>
</section>
