---
/** Questions that open in place (no script). */
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f) => (
      <details class="reveal">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>
