---
/**
 * The strip above every page's header: the newest current notice marked `banner`. Closing it hides that notice in
 * this browser (a new notice shows again); it also hides itself once its `showUntil` day has passed.
 */
import Icon from './Icon.astro';
import { currentNotices, noticeLink } from '../lib/notices';

const notice = (await currentNotices()).find((n) => n.banner);
---

{
  notice && (
    <aside class="strip" aria-label="Notice" data-notice={notice.id} data-until={notice.showUntil}>
      <div class="wrap strip-inner">
        <span class="strip-type">{notice.type}</span>
        <a class="strip-text" href={noticeLink(notice)}>
          <span>{notice.title}</span>
          <span class="strip-more">
            {notice.linkText ?? 'Read more'}
            <Icon name="arrow" size={16} />
          </span>
        </a>
        <button type="button" class="strip-close" aria-label="Close this notice">
          <Icon name="close" size={18} />
        </button>
      </div>
      <script is:inline>
        (function () {
          var strip = document.currentScript.parentElement;
          var key = 'notice-closed:' + strip.dataset.notice;
          try { if (localStorage.getItem(key)) strip.hidden = true; } catch (e) {}
          strip.querySelector('.strip-close').addEventListener('click', function () {
            strip.hidden = true;
            try { localStorage.setItem(key, '1'); } catch (e) {}
          });
        })();
      </script>
    </aside>
  )
}
