---
/** One installation as a card: its photo (opening large in the page's Lightbox.astro), who and where, size and panels. */
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { kw, photoAlt, photoCaption, type Installation } from '../lib/installations';

interface Props {
  item: Installation;
}

const { item: i } = Astro.props;
const full = i.photo && (await getImage({ src: i.photo, width: Math.min(1600, i.photo.width), format: 'webp', quality: 78 })).src;
---

<article class="inst-card reveal">
  <div class="inst-media">
    {
      i.photo ? (
        <button
          type="button"
          class="inst-photo"
          data-gallery-item
          data-kind="photo"
          data-full={full}
          data-alt={photoAlt(i)}
          data-caption={photoCaption(i)}
          aria-label={`View the photo: ${photoAlt(i)}`}>
          <Image src={i.thumb ?? i.photo} alt="" widths={[320, 480]} sizes="(min-width: 1000px) 380px, (min-width: 640px) 46vw, 92vw" format="webp" quality={70} loading="lazy" />
        </button>
      ) : (
        <Icon name="sun" size={40} />
      )
    }
  </div>
  <div class="inst-body">
    <h3>{i.customer}</h3>
    <p class="inst-place"><Icon name="pin" size={16} />{i.where}{i.month && ` · ${i.month}`}</p>
    <ul class="inst-facts" role="list">
      <li>{kw(i.capacityKw)}</li>
      <li>{i.panels}</li>
    </ul>
  </div>
</article>
